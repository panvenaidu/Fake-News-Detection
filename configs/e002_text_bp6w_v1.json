{
  "protocol_id": "BP-6W-v1",
  "experiment_id": "E002",
  "task": {
    "name": "Fakeddit 6-way text-only classification",
    "label_column": "6_way_label",
    "num_classes": 6,
    "label_mapping": {
      "0": "True",
      "1": "Satire/Parody",
      "2": "Misleading Content",
      "3": "Imposter Content",
      "4": "False Connection",
      "5": "Manipulated Content"
    }
  },
  "data": {
    "manifest_path": "data/verified_paired_manifest.csv",
    "manifest_sha256": "fc74cb42288d366131ac764bf02f9212bacd7cab0af68442a003beaaff9fde20",
    "text_column": "clean_title",
    "expected_split_counts": {
      "train": 62635,
      "validate": 6685,
      "test": 6675
    }
  },
  "model": {
    "name": "bert-base-uncased",
    "revision": "86b5e0934494bd15c9632b12f734a8a67f723594",
    "classifier_representation": "BERT pooler output, with CLS fallback",
    "classifier_dropout": 0.2
  },
  "tokenizer": {
    "implementation": "BertTokenizerFast",
    "max_length": 128,
    "truncation": true,
    "padding": "dynamic-longest-in-batch"
  },
  "data_loader": {
    "num_workers": 4
  },
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 2e-05,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "epsilon": 1e-08,
    "exclude_from_weight_decay": ["bias", "normalization parameters"]
  },
  "training": {
    "fine_tune_end_to_end": true,
    "loss": "unweighted cross entropy",
    "micro_batch_size": 32,
    "gradient_accumulation_steps": 1,
    "effective_batch_size": 32,
    "max_epochs": 10,
    "max_grad_norm": 1.0,
    "use_cuda_amp": true,
    "canonical_cuda_required": true,
    "seeds": [42, 43, 44]
  },
  "scheduler": {
    "name": "linear warm-up then linear decay",
    "warmup_ratio": 0.1
  },
  "early_stopping": {
    "start_after_epoch": 3,
    "patience": 2,
    "min_delta": 0.001,
    "monitor": "validation macro-F1"
  },
  "evaluation": {
    "checkpoint_selection": "validation Macro-F1; exact ties use lower validation loss then earlier epoch",
    "test_after_validation_selection_only": true,
    "metrics": [
      "macro_f1",
      "accuracy",
      "balanced_accuracy",
      "weighted_f1",
      "per_class_precision_recall_f1_support",
      "raw_confusion_matrix",
      "normalized_confusion_matrix"
    ]
  },
  "artifacts": {
    "output_root": "results/experiments/e002_text"
  },
  "smoke_test": {
    "seed": 42,
    "batch_size": 2,
    "num_workers": 0,
    "non_canonical_cpu_only": true
  }
}
