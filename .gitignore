# Data (large files — do not commit)
data/
*.tsv
*.csv
# Retain small official-run numerical evidence when synced from Colab.
!results/experiments/official_text/**/*.csv
!results/experiments/multimodal/**/*.csv
images/
images.zip

# Model checkpoints
checkpoints/
*.pt
*.pth
*.ckpt
*.bin

# Python
